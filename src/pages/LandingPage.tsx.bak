          </div>
        </div>
      </div>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          { icon: "ac_unit", bg: "bg-surface-container-lowest", iconBg: "bg-primary-container", iconColor: "text-primary", title: "The Calm Tone", desc: "A whisper of guidance during peaceful rhythms. Perfect for evening reflections and legacy journaling.", label: "ALWAYS AVAILABLE" },
          { icon: "notifications_active", bg: "bg-primary-container", iconBg: "bg-surface-container-lowest", iconColor: "text-primary", title: "The Alert Tone", desc: "Active vigilance when schedules shift or developmental milestones approach.", label: "PROACTIVE CARE" },
          { icon: "shield_with_heart", bg: "bg-[#FDF2F4]", iconBg: "bg-[#ffdad6]", iconColor: "text-error", title: "Emergency Presence", desc: "Immediate, surgical focus when it matters most. Authoritative, fast, and compassionate.", label: "ALWAYS ON" },
        ].map((c, i) => (
          <div key={i} className={`p-9 ${c.bg} rounded-2xl flex flex-col gap-5 hover:shadow-xl transition-all duration-500 group glass-gold-edge`}>
            <div className={`w-12 h-12 ${c.iconBg} flex items-center justify-center rounded-xl shadow-sm`}>
              <span className={`material-symbols-outlined text-xl ${c.iconColor}`} style={{ fontVariationSettings: "'FILL' 1" }}>{c.icon}</span>
            </div>
            <div className="space-y-2">
              <h3 className="font-serif text-2xl text-on-surface">{c.title}</h3>
              <p className="text-on-surface-variant leading-relaxed font-light text-sm">{c.desc}</p>
            </div>
            <span className="label-md text-primary/60 tracking-widest opacity-0 group-hover:opacity-100 transition-opacity text-[9px]">{c.label} →</span>
          </div>
        ))}
      </div>
    </div>
  </section>
);

/* ─── Life Cycles Sticky Scroll ──────────────────────────── */
const LifeCycleTimeline = () => {
  const containerRef = useRef<HTMLDivElement>(null);
  const imagesRef = useRef<(HTMLImageElement | null)[]>([]);
  const textsRef = useRef<(HTMLDivElement | null)[]>([]);

  const stages = [
    { id: "expecting", icon: "pregnant_woman", label: "Expecting", title: "The First Breath", aiHint: "AI prepares prenatal routines", desc: "Starting a family requires a rhythm. Neev prepares your foundational routines before the arrival — guided by tradition and AI.", img: "/images/neev_role_mother.png", remote: REMOTE.mother },
    { id: "infancy", icon: "child_care", label: "Infancy", title: "Nurturing Growth", aiHint: "Guardian tracks feeds & sleep", desc: "Track feeds, sleep patterns, and vital milestones seamlessly across the entire care team. Nothing is ever missed.", img: "/images/neev_real_guardian.png", remote: REMOTE.child },
    { id: "first-steps", icon: "footprint", label: "First Steps", title: "Expanding Worlds", aiHint: "Auto-journaled in the Vault", desc: "As they explore, Neev chronicles these fleeting moments into your family vault automatically. Forever.", img: "/images/neev_role_child.png", remote: REMOTE.child },
    { id: "schooling", icon: "school", label: "Schooling", title: "The Academic Inquiry", aiHint: "Gmail parsed, calendar synced", desc: "Synchronize school calendars, AI-parsing every circular and email into a single unified family schedule.", img: "/images/neev_role_father.png", remote: REMOTE.schoolingKids },
    { id: "studying", icon: "menu_book", label: "Studying", title: "Focused Learning", aiHint: "AI study planner active", desc: "Support late-night study sessions with AI-tailored learning routines, milestone tracking, and adaptive schedules.", img: "/images/neev_real_goals.png", remote: REMOTE.studyingStudent },
    { id: "college", icon: "account_balance", label: "College & University", title: "Higher Education", aiHint: "Admission docs stored in Vault", desc: "Guiding the transition to campus life while maintaining deep familial bonds across any distance.", img: "/images/neev_role_elder.png", remote: REMOTE.collegeStudents },
    { id: "career", icon: "work", label: "Career Start", title: "Entering the Workforce", aiHint: "Offer letter secured in Vault", desc: "The transition from academia to professional life. Guardian celebrates the milestone and archives the moment.", img: "/images/neev_real_home.png", remote: REMOTE.newJob },
    { id: "marriage", icon: "volunteer_activism", label: "Marriage", title: "Arranged Unity", aiHint: "Rituals & memories preserved", desc: "Expanding the family tree through sacred unions. Neev preserves the ceremonies, vows, and celebrations forever.", img: "/images/neev_real_connection.png", remote: REMOTE.marriage },
    { id: "elder-support", icon: "diversity_3", label: "Elder Support", title: "Infinite Lineage", aiHint: "Guardian voice bridges generations", desc: "When roles reverse, support aging parents while passing the digital heirloom to the next generation.", img: "/images/neev_role_elder.png", remote: REMOTE.elder },
  ];

  useEffect(() => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!prefersReducedMotion) {
      const ctx = gsap.context(() => {
        textsRef.current.forEach((text, i) => {
          if (!text) return;
          ScrollTrigger.create({
            trigger: text, start: "top center", end: "bottom center",
            onEnter: () => {
              gsap.to(imagesRef.current, { opacity: 0, duration: 0.7, overwrite: "auto" });
              gsap.to(imagesRef.current[i], { opacity: 1, duration: 0.7, overwrite: "auto" });
              gsap.to(text, { opacity: 1, x: 0, duration: 0.7, overwrite: "auto" });
            },
            onEnterBack: () => {
              gsap.to(imagesRef.current, { opacity: 0, duration: 0.7, overwrite: "auto" });
              gsap.to(imagesRef.current[i], { opacity: 1, duration: 0.7, overwrite: "auto" });
              gsap.to(text, { opacity: 1, x: 0, duration: 0.7, overwrite: "auto" });
            },
            onLeave: () => gsap.to(text, { opacity: 0.12, x: -16, duration: 0.6, overwrite: "auto" }),
            onLeaveBack: () => gsap.to(text, { opacity: 0.12, x: -16, duration: 0.6, overwrite: "auto" }),
          });
        });
        if (imagesRef.current[0]) gsap.set(imagesRef.current[0], { opacity: 1 });
      }, containerRef);
      return () => ctx.revert();
    } else {
      imagesRef.current.forEach((img) => img && (img.style.opacity = "1"));
      textsRef.current.forEach((t) => { if (t) { t.style.opacity = "1"; t.style.transform = "none"; } });
    }
  }, []);

  return (
    <section ref={containerRef} id="life-cycles" className="relative bg-surface">
      <div className="max-w-screen-2xl mx-auto flex flex-col md:flex-row">
        {/* Sticky image pane */}
        <div className="w-full md:w-1/2 h-[50vh] md:h-screen sticky top-0 overflow-hidden">
          {stages.map((s, i) => (
            <img
              key={i}
              ref={(el) => (imagesRef.current[i] = el)}
              src={s.img}
              alt={s.label}
              onError={(e) => { const el = e.currentTarget; if (el.src !== s.remote) el.src = s.remote; }}
              className="absolute inset-0 w-full h-full object-cover opacity-0 scale-105 transition-transform duration-1000"
            />
          ))}
          <div className="absolute inset-0 bg-gradient-to-r from-surface/60 via-transparent to-transparent hidden md:block" />
          <div className="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent md:hidden" />
          {/* Stage counter overlay */}
          <div className="absolute top-6 left-6 bg-surface/80 backdrop-blur-xl glass-gold-edge px-4 py-2 rounded-full hidden md:flex items-center gap-3">
            <div className="w-1.5 h-1.5 rounded-full bg-primary animate-pulse" />
            <span className="label-md text-primary tracking-[0.2em]">THE HERITAGE PATH</span>
          </div>
        </div>
        {/* Scrolling text pane */}
        <div className="w-full md:w-1/2 py-16 px-8 md:px-14">
          <div className="mb-20">
            <span className="label-md text-primary tracking-[0.35em]">THE HERITAGE PATH</span>
            <h2 className="font-serif text-4xl md:text-6xl text-on-surface mt-4 leading-tight">The Cycle of <span className="text-sage-italic">Growth</span></h2>
            <p className="text-on-surface-variant font-light mt-4 max-w-sm">Nine chapters. One unbroken lineage. Every milestone preserved with AI so nothing is ever left behind.</p>
          </div>
          <div className="space-y-[36vh]">
            {stages.map((s, i) => (
              <div key={i} ref={(el) => (textsRef.current[i] = el)} className="min-h-[36vh] flex flex-col justify-center opacity-[0.12] -translate-x-4">
                <div className="w-14 h-14 bg-surface-container glass-gold-edge flex items-center justify-center rounded-2xl mb-5 shadow-md text-primary transition-all duration-500 group-hover:scale-110">
                  <span className="material-symbols-outlined text-2xl" style={{ fontVariationSettings: "'FILL' 1" }}>{s.icon}</span>
                </div>
                <div className="flex items-center gap-3 mb-2">
                  <span className="label-md tracking-widest text-primary font-bold">{s.label.toUpperCase()}</span>
                  <span className="text-[9px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-sans font-medium tracking-wide">{s.aiHint}</span>
                </div>
                <h3 className="font-serif text-3xl text-on-surface mb-3">{s.title}</h3>
                <p className="text-base text-on-surface-variant font-light leading-relaxed max-w-md">{s.desc}</p>
              </div>
            ))}
          </div>
          <div className="h-[18vh]" />
        </div>
      </div>
    </section>
  );
};

