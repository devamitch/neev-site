/* ─── Resilient Img component — falls back to remote on error ─ */
const Img = ({
  src,
  fallback,
  alt,
  className,
}: {
  src: string;
  fallback: string;
  alt: string;
  className?: string;
}) => (
  <img
    src={src}
    alt={alt}
    className={className}
    onError={(e) => {
      const el = e.currentTarget;
      if (el.src !== fallback) el.src = fallback;
    }}
  />
);

