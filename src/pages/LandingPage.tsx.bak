          <div className="absolute top-5 -right-5 bg-surface-container-lowest glass-gold-edge px-4 py-3 rounded-xl shadow-xl hidden lg:block animate-float-delay">
            <p className="label-md text-on-surface-variant/60 tracking-[0.15em] mb-1">ACTIVE STAGE</p>
            <p className="font-serif italic text-sm text-primary">Schooling · Growth</p>
            <div className="mt-2 h-1 w-full bg-surface-container rounded-full overflow-hidden"><div className="h-full bg-primary w-2/5 rounded-full transition-all duration-1000" /></div>
          </div>
        </div>
      </div>
    </section>
  );
};

