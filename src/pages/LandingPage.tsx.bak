/* ─── Hero ──────────────────────────────────────────────── */
const Hero = () => {
  const { user } = useAuth();
  const navigate = useNavigate();
  const textRef = useRef<HTMLDivElement>(null);
  const imageRef = useRef<HTMLDivElement>(null);
  const planeRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const ctx = gsap.context(() => {
      gsap.timeline()
        .from(textRef.current?.children || [], { y: 40, opacity: 0, stagger: 0.12, duration: 1.2, ease: "expo.out" })
        .from(imageRef.current, { scale: 1.06, opacity: 0, duration: 1.4, ease: "power2.out" }, "-=1")
        .from(planeRef.current, { x: 36, opacity: 0, duration: 0.9, ease: "power3.out" }, "-=0.8");
    });
    return () => ctx.revert();
  }, []);

  return (
    <section className="relative max-w-screen-2xl mx-auto px-8 pt-28 pb-14 overflow-hidden">
      {/* Ambient orbs */}
      <div className="absolute top-0 right-1/3 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[120px] pointer-events-none animate-orb-pulse" />
      <div className="absolute bottom-0 left-0 w-[400px] h-[400px] bg-tertiary-container/20 rounded-full blur-[100px] pointer-events-none animate-orb-pulse delay-700" />
      <div className="flex flex-col lg:flex-row items-center gap-12 relative z-10">
        <div ref={textRef} className="lg:w-7/12 space-y-6">
          <div className="inline-flex items-center gap-3 border border-primary/20 bg-primary-container/40 backdrop-blur-sm px-4 py-2 rounded-full">
            <div className="w-1.5 h-1.5 rounded-full bg-primary animate-pulse" />
            <span className="label-md text-primary tracking-[0.3em]">NEEV · THE MODERN HEIRLOOM</span>
          </div>
          <h1 className="font-serif text-[3.5rem] md:text-[5rem] leading-[0.93] tracking-tight text-on-surface">
            Build your family's<br />
            <span className="shimmer-text">Foundation</span><br />
            with wisdom.
          </h1>
          <p className="text-base text-on-surface-variant max-w-lg leading-relaxed font-light">
            An AI-powered digital sanctuary for the modern Indian family. Let Google, AI, and cultural wisdom work together—so <em className="font-serif text-on-surface">nothing is ever left behind.</em>
          </p>
          <div className="flex flex-wrap items-center gap-4 pt-1">
            {user ? (
              <button onClick={() => navigate("/dashboard")} className="group relative bg-primary text-on-primary px-8 py-3.5 rounded-lg label-md tracking-[0.2em] hover:opacity-90 transition-all active:scale-95 shadow-lg shadow-primary/25 overflow-hidden">
                <span className="relative z-10">Go to Dashboard</span>
                <div className="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300" />
              </button>
            ) : (
              <button onClick={() => navigate("/signup")} className="group relative bg-primary text-on-primary px-8 py-3.5 rounded-lg label-md tracking-[0.2em] hover:opacity-90 transition-all active:scale-95 shadow-lg shadow-primary/25 overflow-hidden">
                <span className="relative z-10">Begin the Cycle</span>
                <div className="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300" />
              </button>
            )}
            <button onClick={() => document.getElementById("sanctuary")?.scrollIntoView({ behavior: "smooth" })} className="border border-outline-variant text-on-surface-variant px-8 py-3.5 rounded-lg label-md tracking-[0.2em] hover:border-primary hover:text-primary transition-all">
              The Philosophy
            </button>
          </div>
          <div className="flex items-center gap-5 pt-2">
            <div className="flex -space-x-2.5">
              {["/images/neev_role_mother.png", "/images/neev_role_father.png", "/images/neev_role_elder.png"].map((src, i) => (
                <img key={i} src={src} alt="" className="w-9 h-9 rounded-full border-2 border-surface object-cover shadow-md" />
              ))}
              <div className="w-9 h-9 rounded-full border-2 border-surface bg-primary flex items-center justify-center shadow-md"><span className="text-[9px] font-bold text-on-primary">+8</span></div>
            </div>
            <div>
              <p className="label-md text-on-surface tracking-[0.12em]">1,000+ FAMILIES</p>
              <p className="text-[9px] text-on-surface-variant tracking-widest">ON THE WAITING LIST</p>
            </div>
          </div>
          {/* AI integration badges */}
          <div className="flex items-center gap-3 pt-1 flex-wrap">
            <span className="label-md text-on-surface-variant/50 tracking-widest">POWERED BY</span>
            {["Google AI", "Gemini", "Claude"].map(ai => (
              <span key={ai} className="text-[10px] font-sans font-semibold tracking-widest bg-surface-container-low border border-outline-variant/30 text-on-surface-variant px-3 py-1.5 rounded-full">{ai}</span>
            ))}
          </div>
        </div>
        <div ref={imageRef} className="lg:w-5/12 relative">
          <div className="aspect-[4/5] rounded-3xl overflow-hidden bg-surface-container-low tilted-img shadow-2xl">
            <img src="/images/neev_real_home.png" alt="Indian family at home" className="w-full h-full object-cover transition-transform duration-700 hover:scale-105" />
            <div className="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent" />
          </div>
          <div ref={planeRef} className="absolute -bottom-4 -left-10 bg-surface/92 backdrop-blur-2xl glass-gold-edge p-5 rounded-2xl shadow-2xl max-w-[250px] hidden lg:block animate-float">
            <div className="flex items-center gap-2 mb-2.5">
              <div className="relative"><div className="w-2 h-2 rounded-full bg-green-400 animate-pulse" /><div className="absolute inset-0 rounded-full bg-green-400 animate-ping opacity-40" /></div>
