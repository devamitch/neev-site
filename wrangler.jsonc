{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neev-site",
  "compatibility_date": "2026-04-26",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "neevsanctuary.devamit.co.in", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SITE_URL": "https://neevsanctuary.devamit.co.in"
  }
}
