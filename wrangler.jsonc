{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neev-site",
  "compatibility_date": "2026-04-26",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "pnpm run build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "neev.devamit.co.in", "custom_domain": true },
    { "pattern": "neevsanctuary.devamit.co.in", "custom_domain": true }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SITE_URL": "https://neev.devamit.co.in"
  }
}
